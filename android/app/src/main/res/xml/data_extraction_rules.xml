<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ cloud-backup and device-transfer rules.
    Noor stores all user data locally only (bookmarks, reading position, preferences,
    adhkar favorites, reminder settings, cached tafsir). None of this is backed up to
    cloud services — backup is disabled via allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
