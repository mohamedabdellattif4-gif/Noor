    <string name="privacy_policy">Privacy policy</string>
    <string name="privacy_policy_body">Noor stores bookmarks, reading position, cached tafsir, adhkar favorites, reminder choices, and preferences only on this device. It does not create accounts, show ads, run analytics, or access contacts, location, photos, microphone, or camera. Optional adhkar reminders use the device notification permission and local WorkManager scheduling. When you stream recitation or request uncached tafsir, the selected provider receives the ordinary network information needed to serve the request, such as your IP address and user agent.</string>
    <string name="source_tanzil_title">Quran text — Tanzil</string>
    <string name="source_tanzil_body">Uthmani Quran text version 1.0.2, copied verbatim under Creative Commons Attribution 3.0 and the Tanzil terms. The displayed Quran text is never modified; a separate normalized field is used only for search.</string>
    <string name="source_quran_meta_title">Pagination metadata — quran-meta</string>
    <string name="source_quran_meta_body">Hafs page, juz, and rub el hizb metadata from quran-meta 6.0.17 under the MIT License.</string>
    <string name="source_online_services_title">Tafsir service — QuranEnc</string>
    <string name="source_online_services_body">The Arabic Muyassar tafsir is requested on demand from QuranEnc and cached locally for offline reuse.</string>
    <string name="source_audio_title">Recitation audio — EveryAyah</string>
    <string name="source_audio_body">Verse audio is streamed on demand from EveryAyah. Noor does not redistribute the audio files inside the app package.</string>
